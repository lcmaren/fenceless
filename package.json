{
	"name": "fenceless",
	"version": "0.2.1",
	"description": "A plain key: value header for Markdown documents: no YAML, no fence, every value a string.",
	"keywords": [
		"frontmatter",
		"markdown",
		"metadata",
		"fmd",
		"parser"
	],
	"license": "MIT",
	"author": "L. C. Maren",
	"type": "module",
	"main": "./dist/fmd.js",
	"types": "./dist/fmd.d.ts",
	"exports": {
		".": {
			"types": "./dist/fmd.d.ts",
			"default": "./dist/fmd.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"packageManager": "pnpm@11.23.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lcmaren/fenceless.git"
	},
	"homepage": "https://github.com/lcmaren/fenceless#readme",
	"bugs": {
		"url": "https://github.com/lcmaren/fenceless/issues"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"prepack": "pnpm build"
	},
	"devDependencies": {
		"typescript": "^5.0.0",
		"vitest": "^4.1.10"
	}
}
